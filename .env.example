# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# Variables already set in the shell win over this file, so do not use AWS_PROFILE here:
# the shell may set it to another profile. The app reads RECEIPT_PRO_AWS_PROFILE instead.

# Personal AWS profile in ~/.aws
RECEIPT_PRO_AWS_PROFILE=receipt-pro
# 12-digit ID of the personal AWS account. Every AWS call is refused unless the profile belongs to it.
RECEIPT_PRO_AWS_ACCOUNT_ID=
AWS_REGION=ap-southeast-2
TABLE_NAME=receipt-pro
BUCKET_NAME=receipt-pro-photos-jasen
# DeepSeek API key, server only (needed from T-002)
DEEPSEEK_API_KEY=
# The one built-in user until login lands in M3. Keep it stable: data is keyed by it.
LOCAL_USER_ID=
